{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default capabilities for NovaVei",
  "windows": ["main"],
  "webviews": ["main"],
  "permissions": [
    "core:event:default",
    "allow-system-info",
    "allow-diagnostics-export",
    "allow-storage-recovery-status",
    "allow-portable-storage-unlock",
    "allow-storage-mode-switch",
    "allow-sessions-list",
    "allow-sessions-create",
    "allow-workspace-picker",
    "allow-workspace-reveal",
    "allow-sessions-get",
    "allow-session-goals",
    "allow-providers-list",
    "allow-provider-test",
    "allow-provider-models-fetch",
    "allow-provider-draft",
    "allow-provider-import",
    "allow-full-permission-confirm",
    "allow-agent-runtime",
    "allow-agent-permission",
    "allow-subagent-runtime",
    "allow-subagent-private-context",
    "allow-subagent-messages",
    "allow-worktree-subagent-runtime",
    "allow-settings",
    "allow-mcp-runtime",
    "allow-mcp-registry",
    "allow-translation",
    "allow-local-services",
    "allow-skills-catalog",
    "allow-chat-history",
    "allow-context-compaction",
    "allow-composer-media",
    "allow-workspace-capability",
    "allow-workspace-read",
    "allow-workspace-mutate",
    "allow-workspace-shell",
    "allow-git-status",
    "allow-git-commit-confirm",
    "allow-git-commit",
    "allow-global-read",
    "allow-proxy-server-info",
    "allow-browser-runtime"
  ]
}
